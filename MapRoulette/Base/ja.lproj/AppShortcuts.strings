"Find nearby ${category} in ${applicationName}" = "${applicationName}で近くの${category}";
"Find nearby spots in ${applicationName}" = "${applicationName}で近くのスポット";
"Show my next trip in ${applicationName}" = "${applicationName}の次の旅";
"Plan a trip in ${applicationName}" = "${applicationName}で旅行を計画";
