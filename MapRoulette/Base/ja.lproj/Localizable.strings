"attraction_nokogiriyama_desc" = "断崖の「地獄のぞき」と巨大な大仏で知られる山。ロープウェーで山頂へ。";
"attraction_sunpu_castle" = "駿府城";
"attraction_sunpu_castle_desc" = "徳川家康が晩年を過ごした城。広々とした公園として整備されている。";
"attraction_omuroyama" = "大室山";
"attraction_omuroyama_desc" = "お椀型の美しい姿が特徴の伊豆のシンボル。リフトで登る山頂からの絶景が魅力。";

"gourmet_shirunashi_tantanmen" = "汁なし担々麺";
"gourmet_shirunashi_tantanmen_desc" = "スープのない担々麺。山椒と唐辛子が効いた広島発祥のピリ辛麺。";
"gourmet_gansu" = "がんす";
"gourmet_gansu_desc" = "魚のすり身を揚げた広島のソウルフード。ふんわり食感でお酒にも合う。";
"gourmet_shinshu_salmon" = "信州サーモン";
"gourmet_shinshu_salmon_desc" = "長野県が育てたブランド魚。きめ細かい身と濃厚な旨みが特徴。";
"gourmet_nagano_gohei_mochi" = "五平餅";
"gourmet_nagano_gohei_mochi_desc" = "つぶしたご飯を串に巻き、甘辛い味噌だれを塗って焼いた郷土食。";
"gourmet_turkish_rice" = "トルコライス";
"gourmet_turkish_rice_desc" = "ピラフ・スパゲティ・トンカツを一皿に盛った長崎の洋食。ボリューム満点。";
"gourmet_hatoshi" = "ハトシ";
"gourmet_hatoshi_desc" = "食パンにエビのすり身を挟んで揚げた長崎の中華風料理。サクサク食感。";
"gourmet_hanton_rice" = "ハントンライス";
"gourmet_hanton_rice_desc" = "オムライスに白身魚フライをのせた金沢の洋食。タルタルソースが定番。";
"gourmet_kanazawa_oden" = "金沢おでん";
"gourmet_kanazawa_oden_desc" = "車麩やバイ貝など独自の種が入る金沢のおでん。出汁がしみた具が美味。";
"gourmet_harako_meshi" = "はらこ飯";
"gourmet_harako_meshi_desc" = "鮭の煮汁で炊いたご飯にいくらと鮭をのせた宮城の郷土料理。秋の味覚。";
"gourmet_aburafu_don" = "あぶら麩丼";
"gourmet_aburafu_don_desc" = "油麩を卵でとじてご飯にのせた宮城北部の名物丼。やさしい味わい。";
"gourmet_asuka_nabe" = "飛鳥鍋";
"gourmet_asuka_nabe_desc" = "牛乳ベースのだしで鶏肉や野菜を煮込む奈良の鍋料理。まろやかな味。";
"gourmet_chagayu" = "茶粥";
"gourmet_chagayu_desc" = "ほうじ茶で炊いたあっさりとした奈良の郷土食。「奈良の朝はお茶粥から」とも。";
"gourmet_futomaki_sushi" = "太巻き祭り寿司";
"gourmet_futomaki_sushi_desc" = "切り口に花や絵柄が現れる千葉の華やかな飾り巻き寿司。";
"gourmet_hakarime_don" = "はかりめ丼";
"gourmet_hakarime_don_desc" = "富津名物の穴子を甘辛いタレで味わう丼。「はかりめ」は穴子の地元名。";
"gourmet_shizuoka_oden" = "静岡おでん";
"gourmet_shizuoka_oden_desc" = "黒いだしに串刺しの具を煮込み、だし粉と青のりをかける静岡のおでん。";
"gourmet_fujinomiya_yakisoba" = "富士宮やきそば";
"gourmet_fujinomiya_yakisoba_desc" = "コシの強い専用麺と肉かすが特徴のご当地焼きそば。B級グルメの代表格。";

"hiroshima.toyoka.name" = "桐葉菓";
"hiroshima.toyoka.description" = "もち粉の生地で粒あんを包んで焼いた広島銘菓。もちもち食感が人気。";
"hiroshima.toyoka.price" = "650円〜";
"hiroshima.lemon_cake.name" = "レモンケーキ";
"hiroshima.lemon_cake.description" = "瀬戸内産レモンを使った爽やかな焼き菓子。広島土産の定番。";
"hiroshima.lemon_cake.price" = "600円〜";
"nagasaki.kujuku_sempei.name" = "九十九島せんぺい";
"nagasaki.kujuku_sempei.description" = "ピーナッツを散りばめた瓦型の軽い煎餅。佐世保発祥の長崎銘菓。";
"nagasaki.kujuku_sempei.price" = "600円〜";
"nagasaki.nagasaki_monogatari.name" = "長崎物語";
"nagasaki.nagasaki_monogatari.description" = "カステラ生地でクリームを巻いたロール状の銘菓。";
"nagasaki.nagasaki_monogatari.price" = "700円〜";
"nara.narazuke.name" = "奈良漬";
"nara.narazuke.description" = "瓜や胡瓜を酒粕に漬け込んだ奈良発祥の伝統漬物。";
"nara.narazuke.price" = "600円〜";
"nara.kaki_no_ha_cha.name" = "柿の葉茶";
"nara.kaki_no_ha_cha.description" = "ビタミン豊富な柿の葉で作る奈良のお茶。香ばしくまろやか。";
"nara.kaki_no_ha_cha.price" = "500円〜";
"miyagi.shiogama_kohada.name" = "しおがま";
"miyagi.shiogama_kohada.description" = "塩釜の藻塩を使った上品な甘さの落雁。古くからの宮城銘菓。";
"miyagi.shiogama_kohada.price" = "500円〜";
"miyagi.kikufuku.name" = "喜久福";
"miyagi.kikufuku.description" = "生クリームとあんを餅で包んだ仙台の人気和スイーツ。ずんだ味も。";
"miyagi.kikufuku.price" = "700円〜";
"chiba.nure_senbei.name" = "ぬれ煎餅";
"chiba.nure_senbei.description" = "醤油だれをたっぷり染み込ませたしっとり食感の銚子名物煎餅。";
"chiba.nure_senbei.price" = "400円〜";
"chiba.peanut_sub.name" = "落花生サブレ";
"chiba.peanut_sub.description" = "千葉産落花生の風味を生かした香ばしいサブレ。";
"chiba.peanut_sub.price" = "600円〜";
"ishikawa.shibafune.name" = "柴舟";
"ishikawa.shibafune.description" = "生姜を効かせた薄焼きせんべい。金沢の伝統銘菓。";
"ishikawa.shibafune.price" = "600円〜";
"ishikawa.kaga_bocha.name" = "加賀棒茶";
"ishikawa.kaga_bocha.description" = "茎を焙じた香ばしい金沢のほうじ茶。すっきりとした味わい。";
"ishikawa.kaga_bocha.price" = "500円〜";
"nagano.oyaki.name" = "おやき";
"nagano.oyaki.description" = "野沢菜やあんこを小麦の生地で包んで焼いた長野の郷土食。";
"nagano.oyaki.price" = "150円〜";
"nagano.kurumi_yubeshi.name" = "くるみゆべし";
"nagano.kurumi_yubeshi.description" = "くるみを練り込んだもちもちの和菓子。信州土産の定番。";
"nagano.kurumi_yubeshi.price" = "500円〜";
"shizuoka.wasabi_zuke.name" = "わさび漬け";
"shizuoka.wasabi_zuke.description" = "わさびを酒粕に漬けた静岡名物。ツンとした辛みとほのかな甘み。";
"shizuoka.wasabi_zuke.price" = "500円〜";
"shizuoka.abekawa_mochi.name" = "安倍川もち";
"shizuoka.abekawa_mochi.description" = "やわらかい餅にきな粉やあんをまぶした静岡の伝統和菓子。";
"shizuoka.abekawa_mochi.price" = "600円〜";
