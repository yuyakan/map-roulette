"attraction_kaiyukan" = "海游馆";
"attraction_kaiyukan_desc" = "位于天保山的世界级大型水族馆。鲸鲨畅游的巨型水槽是亮点。";
"attraction_expo_park" = "万博纪念公园";
"attraction_expo_park_desc" = "坐落于大阪世博会旧址的公园。冈本太郎创作的太阳之塔为其象征。";

"gourmet_chanko_nabe" = "相扑火锅";
"gourmet_chanko_nabe_desc" = "源自相扑部屋的什锦火锅，加入大量肉、海鲜和蔬菜炖煮，营养满分。";
"gourmet_edomae_tempura" = "江户前天妇罗";
"gourmet_edomae_tempura_desc" = "使用东京湾海鲜制作的江户前天妇罗，外皮酥脆，尽显食材鲜美。";
"gourmet_miso_nikomi_udon" = "味噌炖乌冬";
"gourmet_miso_nikomi_udon_desc" = "用浓郁豆味噌汤汁炖煮的名古屋名物，面条筋道，砂锅滚烫。";
"gourmet_ankake_spa" = "勾芡意面";
"gourmet_ankake_spa_desc" = "淋上浓稠辣味酱汁的名古屋发祥意面，与粗面条相得益彰。";
"gourmet_niku_sui" = "肉吸";
"gourmet_niku_sui_desc" = "如同去掉面条的牛肉乌冬，是大阪的高汤料理，牛肉与高汤鲜味十足。";
"gourmet_doteyaki" = "土手烧";
"gourmet_doteyaki_desc" = "用味噌和味醂慢炖牛筋的大阪经典，串着食用，是居酒屋的人气菜品。";
"gourmet_taco_rice" = "塔可饭";
"gourmet_taco_rice_desc" = "将塔可配料铺在米饭上的冲绳料理，份量十足，老少皆宜。";
"gourmet_rafute" = "卤肉";
"gourmet_rafute_desc" = "用泡盛和黑糖甜咸炖煮猪五花的冲绳乡土料理，入口即化。";

"tokyo.goma_tamago.name" = "芝麻蛋";
