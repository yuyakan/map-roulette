"attraction_toyosu_market" = "丰洲市场";
"attraction_toyosu_market_desc" = "由筑地迁移而来的东京厨房。可享用新鲜海鲜、参观金枪鱼拍卖及场内食堂。";
"attraction_shinjuku_gyoen" = "新宿御苑";
