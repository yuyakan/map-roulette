"attraction_omuroyama" = "大室山";
"attraction_omuroyama_desc" = "以碗状优美姿态为特色的伊豆象征。乘缆椅登顶的绝景是魅力所在。";

"gourmet_shirunashi_tantanmen" = "无汤担担面";
"gourmet_shirunashi_tantanmen_desc" = "没有汤的担担面。花椒与辣椒提味的广岛发祥微辣面。";
"gourmet_gansu" = "炸鱼饼";
"gourmet_gansu_desc" = "油炸鱼糜的广岛灵魂美食。口感松软，也很下酒。";
"gourmet_shinshu_salmon" = "信州三文鱼";
"gourmet_shinshu_salmon_desc" = "长野县培育的品牌鱼。肉质细腻、鲜味浓郁是其特色。";
"gourmet_nagano_gohei_mochi" = "五平饼";
"gourmet_nagano_gohei_mochi_desc" = "将捣碎的米饭裹在扦子上，涂上甜咸味噌酱烤制的乡土美食。";
"gourmet_turkish_rice" = "土耳其饭";
"gourmet_turkish_rice_desc" = "将抓饭、意面、炸猪排盛于一盘的长崎洋食。份量十足。";
"gourmet_hatoshi" = "虾多士";
"gourmet_hatoshi_desc" = "在吐司中夹入虾糜油炸的长崎中华风料理。口感酥脆。";
"gourmet_hanton_rice" = "Hanton饭";
"gourmet_hanton_rice_desc" = "在蛋包饭上放白身鱼炸物的金泽洋食。塔塔酱是经典。";
"gourmet_kanazawa_oden" = "金泽关东煮";
"gourmet_kanazawa_oden_desc" = "加入车麸、海螺等独特食材的金泽关东煮。入味的食材美味。";
"gourmet_harako_meshi" = "鲑鱼亲子饭";
"gourmet_harako_meshi_desc" = "用鲑鱼煮汁焖饭并铺上鲑鱼与鱼籽的宫城乡土料理。秋季美味。";
"gourmet_aburafu_don" = "油麸盖饭";
"gourmet_aburafu_don_desc" = "将油麸用蛋液煮后盖于饭上的宫城北部名物盖饭。味道温和。";
"gourmet_asuka_nabe" = "飞鸟锅";
"gourmet_asuka_nabe_desc" = "以牛奶为底炖煮鸡肉与蔬菜的奈良火锅。口味醇和。";
"gourmet_chagayu" = "茶粥";
"gourmet_chagayu_desc" = "用焙茶熬煮的清爽奈良乡土食。素有「奈良的早晨从茶粥开始」之说。";
"gourmet_futomaki_sushi" = "太卷祭寿司";
"gourmet_futomaki_sushi_desc" = "切口浮现花朵或图案的千叶华丽装饰卷寿司。";
"gourmet_hakarime_don" = "穴子盖饭";
"gourmet_hakarime_don_desc" = "用甜咸酱汁品尝富津名物穴子的盖饭。「hakarime」是穴子的当地名。";
"gourmet_shizuoka_oden" = "静冈关东煮";
"gourmet_shizuoka_oden_desc" = "在黑色高汤中炖煮串好的食材，撒上高汤粉与青海苔的静冈关东煮。";
"gourmet_fujinomiya_yakisoba" = "富士宫炒面";
"gourmet_fujinomiya_yakisoba_desc" = "以筋道专用面与肉渣为特色的当地炒面。B级美食的代表。";

"hiroshima.toyoka.name" = "桐叶菓";
"hiroshima.toyoka.description" = "用糯米粉皮包裹豆沙烤制的广岛名点。软糯口感广受欢迎。";
"hiroshima.toyoka.price" = "650日元起";
"hiroshima.lemon_cake.name" = "柠檬蛋糕";
"hiroshima.lemon_cake.description" = "使用濑户内产柠檬的清爽烘焙点心。广岛伴手礼经典。";
"hiroshima.lemon_cake.price" = "600日元起";
"nagasaki.kujuku_sempei.name" = "九十九岛仙贝";
"nagasaki.kujuku_sempei.description" = "点缀花生的瓦片状轻脆仙贝。佐世保发祥的长崎名点。";
"nagasaki.kujuku_sempei.price" = "600日元起";
"nagasaki.nagasaki_monogatari.name" = "长崎物语";
"nagasaki.nagasaki_monogatari.description" = "用蜂蜜蛋糕坯卷入奶油的卷状名点。";
"nagasaki.nagasaki_monogatari.price" = "700日元起";
"nara.narazuke.name" = "奈良渍";
"nara.narazuke.description" = "将瓜与黄瓜腌入酒糟的奈良发祥传统腌菜。";
"nara.narazuke.price" = "600日元起";
"nara.kaki_no_ha_cha.name" = "柿叶茶";
"nara.kaki_no_ha_cha.description" = "用富含维生素的柿叶制成的奈良茶。香气醇和。";
"nara.kaki_no_ha_cha.price" = "500日元起";
"miyagi.shiogama_kohada.name" = "盐釜落雁";
"miyagi.shiogama_kohada.description" = "使用盐釜藻盐、甜味高雅的落雁。自古传承的宫城名点。";
"miyagi.shiogama_kohada.price" = "500日元起";
"miyagi.kikufuku.name" = "喜久福";
"miyagi.kikufuku.description" = "用麻糬包裹鲜奶油与豆沙的仙台人气和式甜点。也有毛豆味。";
"miyagi.kikufuku.price" = "700日元起";
"chiba.nure_senbei.name" = "湿仙贝";
"chiba.nure_senbei.description" = "充分浸入酱油、口感湿润的铫子名物仙贝。";
"chiba.nure_senbei.price" = "400日元起";
"chiba.peanut_sub.name" = "花生酥饼";
"chiba.peanut_sub.description" = "活用千叶产花生风味的香脆酥饼。";
"chiba.peanut_sub.price" = "600日元起";
"ishikawa.shibafune.name" = "柴舟";
"ishikawa.shibafune.description" = "带有生姜风味的薄烤仙贝。金泽的传统名点。";
"ishikawa.shibafune.price" = "600日元起";
"ishikawa.kaga_bocha.name" = "加贺棒茶";
"ishikawa.kaga_bocha.description" = "焙烤茶茎制成的金泽焙茶。口感清爽。";
"ishikawa.kaga_bocha.price" = "500日元起";
"nagano.oyaki.name" = "烤饼";
"nagano.oyaki.description" = "用小麦面皮包裹野泽菜或豆沙烤制的长野乡土食。";
"nagano.oyaki.price" = "150日元起";
"nagano.kurumi_yubeshi.name" = "核桃柚饼";
"nagano.kurumi_yubeshi.description" = "揉入核桃的软糯和菓子。信州伴手礼经典。";
"nagano.kurumi_yubeshi.price" = "500日元起";
"shizuoka.wasabi_zuke.name" = "山葵渍";
"shizuoka.wasabi_zuke.description" = "将山葵腌入酒糟的静冈名物。冲鼻辣味与淡淡甜味。";
"shizuoka.wasabi_zuke.price" = "500日元起";
"shizuoka.abekawa_mochi.name" = "安倍川饼";
"shizuoka.abekawa_mochi.description" = "在软糯麻糬上裹黄豆粉与豆沙的静冈传统和菓子。";
"shizuoka.abekawa_mochi.price" = "600日元起";

