"okinawa.kokuto.price" = "400日元起";
"okinawa.shio_senbei.name" = "盐仙贝";
"okinawa.shio_senbei.description" = "质朴咸味的硬质冲绳仙贝。当地广受喜爱的经典零食。";
"okinawa.shio_senbei.price" = "300日元起";

"attraction_goryokaku" = "五棱郭";
"attraction_goryokaku_desc" = "位于函馆的星形城郭遗址。从塔上眺望的五角形全景与春樱十分美丽。";
