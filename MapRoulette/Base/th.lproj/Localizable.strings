"attraction_suwa_taisha" = "ศาลเจ้าซุวะ";
"attraction_suwa_taisha_desc" = "The head shrine of all Suwa shrines, a historic site known for the Onbashira Festival.";
"attraction_dejima" = "เดจิมะ";
"attraction_dejima_desc" = "The only artificial island open to the West during the isolation era. Experience history in its restored streets.";
"attraction_oura_church" = "โบสถ์โออุระ";
"attraction_oura_church_desc" = "Japan's oldest surviving Christian building, a Gothic-style World Heritage church.";
"attraction_kanazawa_21museum" = "พิพิธภัณฑ์ศิลปะร่วมสมัยแห่งศตวรรษที่ 21";
"attraction_kanazawa_21museum_desc" = "A contemporary art museum in a distinctive circular building, popular for interactive works like the pool.";
"attraction_myoryuji" = "วัดเมียวริว (วัดนินจา)";
"attraction_myoryuji_desc" = "A temple full of hidden stairs and traps, nicknamed the Ninja Temple.";
"attraction_zuihoden" = "สุสานซุยโฮเด็น";
"attraction_zuihoden_desc" = "The lavish mausoleum of Date Masamune, with splendid Momoyama-era carvings and colors.";
"attraction_zao_fox_village" = "หมู่บ้านจิ้งจอกซาโอ";
"attraction_zao_fox_village_desc" = "A popular spot to interact with free-roaming foxes, soothing with its many foxes.";
"attraction_yakushiji" = "วัดยาคุชิ";
"attraction_yakushiji_desc" = "A World Heritage Site known for its beautiful East Pagoda, a classic of Hakuho culture.";
"attraction_hasedera" = "วัดฮาเซเดระ";
"attraction_hasedera_desc" = "An ancient temple in Sakurai called the Temple of Flowers, famous for peonies and hydrangeas.";
"attraction_inubosaki_lighthouse" = "ประภาคารอินุโบซากิ";
"attraction_inubosaki_lighthouse_desc" = "A white lighthouse at Kanto's easternmost point, a famous spot for the first sunrise over the Pacific.";
"attraction_nokogiriyama" = "ภูเขาโนโคกิริ";
"attraction_nokogiriyama_desc" = "A mountain known for its cliff-edge Hell Lookout and giant Buddha, reached by ropeway.";
"attraction_sunpu_castle" = "ปราสาทซุนปุ";
"attraction_sunpu_castle_desc" = "The castle where Tokugawa Ieyasu spent his later years, now a spacious park.";
"attraction_omuroyama" = "ภูเขาโอมุโระ";
"attraction_omuroyama_desc" = "An Izu symbol with a beautiful bowl shape, offering stunning summit views reached by chairlift.";

"gourmet_shirunashi_tantanmen" = "ทันทันเมนแห้ง";
"gourmet_shirunashi_tantanmen_desc" = "ทันทันเมนไร้น้ำซุป เผ็ดด้วยพริกและพริกหอมเสฉวน กำเนิดฮิโรชิมะ";
"gourmet_gansu" = "กันสึ";
"gourmet_gansu_desc" = "อาหารในดวงใจของฮิโรชิมะ ปลาบดทอด สัมผัสฟูนุ่มเข้ากับเครื่องดื่ม";
"gourmet_shinshu_salmon" = "แซลมอนชินชู";
"gourmet_shinshu_salmon_desc" = "ปลาแบรนด์ที่จังหวัดนางาโนะเพาะเลี้ยง เด่นด้วยเนื้อละเอียดและรสเข้มข้น";
"gourmet_nagano_gohei_mochi" = "โกเฮโมจิ";
"gourmet_nagano_gohei_mochi_desc" = "ข้าวบดพันแท่งไม้ ทาซอสมิโซะหวานเผ็ดแล้วย่าง";
"gourmet_turkish_rice" = "ตุรกีไรซ์";
"gourmet_turkish_rice_desc" = "อาหารฝรั่งของนางาซากิ วางพิลาฟ สปาเกตตี และหมูทอดในจานเดียว อิ่มมาก";
"gourmet_hatoshi" = "ฮาโตชิ";
"gourmet_hatoshi_desc" = "อาหารจีนสไตล์นางาซากิ สอดปลาบดกุ้งในขนมปังแล้วทอดกรอบ";
"gourmet_hanton_rice" = "ฮันตงไรซ์";
"gourmet_hanton_rice_desc" = "อาหารฝรั่งของคานาซาวะ วางปลาขาวทอดบนออมไรซ์ ราดทาร์ทาร์เป็นสูตรมาตรฐาน";
"gourmet_kanazawa_oden" = "โอเด้งคานาซาวะ";
"gourmet_kanazawa_oden_desc" = "โอเด้งคานาซาวะที่มีเครื่องเฉพาะตัว เช่น ฟุกลูตินและหอยไบงาอิ ในน้ำดาชิรสกลมกล่อม";
"gourmet_harako_meshi" = "ฮาราโกะเมชิ (ข้าวหน้าแซลมอนกับไข่)";
"gourmet_harako_meshi_desc" = "อาหารพื้นเมืองมิยางิ ข้าวหุงในน้ำต้มแซลมอน ท็อปด้วยแซลมอนและไข่ปลา รสชาติฤดูใบไม้ร่วง";
"gourmet_aburafu_don" = "ข้าวหน้าอาบุระฟุ";
"gourmet_aburafu_don_desc" = "ข้าวหน้าขึ้นชื่อทางเหนือของมิยางิ กลูเตนทอดตุ๋นกับไข่ รสละมุน";
"gourmet_asuka_nabe" = "อาสุกะนาเบะ";
"gourmet_asuka_nabe_desc" = "หม้อไฟของนาระ ตุ๋นไก่และผักในน้ำดาชิฐานนม รสกลมกล่อม";
"gourmet_chagayu" = "ชากายุ (โจ๊กชา)";
"gourmet_chagayu_desc" = "โจ๊กข้าวของนาระ หุงด้วยชาโฮจิ รสอ่อนๆ นิยมกินเป็นอาหารเช้า";
"gourmet_futomaki_sushi" = "ฟุโตมากิ (ซูชิเทศกาล)";
"gourmet_futomaki_sushi_desc" = "ซูชิม้วนตกแต่งอันงดงามของชิบะ ปรากฏลายดอกไม้หรือลวดลายเมื่อหั่น";
"gourmet_hakarime_don" = "ฮาคาริเมะดง (ข้าวหน้าปลาไหลข้าว)";
"gourmet_hakarime_don_desc" = "ข้าวหน้าขึ้นชื่อฟุตสึ ปลาไหลทะเลราดซอสหวานเค็ม \"ฮาคาริเมะ\" คือชื่อท้องถิ่นของอานาโกะ";
"gourmet_shizuoka_oden" = "โอเด้งชิซุโอกะ";
"gourmet_shizuoka_oden_desc" = "โอเด้งชิซุโอกะ ต้มเครื่องเสียบไม้ในน้ำดาชิสีดำ โรยผงดาชิและสาหร่ายอาโอโนริ";
"gourmet_fujinomiya_yakisoba" = "ยากิโซบะฟุจิโนมิยะ";
"gourmet_fujinomiya_yakisoba_desc" = "ยากิโซบะประจำถิ่นชิซุโอกะ เส้นเหนียวหนึบกับปลาซาร์ดีนป่นเป็นเอกลักษณ์";

