"attraction_jigokudani_monkey_desc" = "Nổi tiếng thế giới với khỉ Nhật ngâm suối nước nóng, cảnh tuyết mùa đông là điểm nhấn";
"attraction_suwa_taisha" = "Đền Suwa";
"attraction_suwa_taisha_desc" = "Đền tổng của mọi đền Suwa cả nước, ngôi đền cổ nổi tiếng với lễ hội Onbashira";
"attraction_dejima" = "Dejima";
"attraction_dejima_desc" = "Đảo nhân tạo duy nhất mở với phương Tây thời bế quan, cảm nhận lịch sử qua phố phường phục dựng";
"attraction_oura_church" = "Nhà thờ Oura";
"attraction_oura_church_desc" = "Công trình Kitô giáo cổ nhất còn tồn tại ở Nhật Bản, nhà thờ kiểu Gothic được ghi danh Di sản Thế giới";
"attraction_kanazawa_21museum" = "Bảo tàng Nghệ thuật Đương đại Thế kỷ 21";
"attraction_kanazawa_21museum_desc" = "Bảo tàng nghệ thuật đương đại trong tòa nhà tròn đặc trưng, các tác phẩm tương tác như bể bơi rất được ưa chuộng";
"attraction_myoryuji" = "Chùa Myoryuji (Chùa Ninja)";
"attraction_myoryuji_desc" = "Ngôi chùa đầy cầu thang ẩn và bẫy, biệt danh Chùa Ninja";
"attraction_zuihoden" = "Lăng Zuihoden";
"attraction_zuihoden_desc" = "Lăng mộ lộng lẫy thờ Date Masamune, chạm khắc và màu sắc kiểu Momoyama tuyệt đẹp";
"attraction_zao_fox_village" = "Làng cáo Zao";
"attraction_zao_fox_village_desc" = "Điểm nổi tiếng giao lưu với cáo thả rông, thư giãn cùng vô số chú cáo";
"attraction_yakushiji" = "Chùa Yakushiji";
"attraction_yakushiji_desc" = "Di sản Thế giới nổi tiếng với tháp Đông đẹp, ngôi chùa cổ tiêu biểu văn hóa Hakuho";
"attraction_hasedera" = "Chùa Hasedera";
"attraction_hasedera_desc" = "Ngôi chùa cổ ở Sakurai được gọi là Chùa Hoa, nổi tiếng hoa mẫu đơn và cẩm tú cầu";
"attraction_inubosaki_lighthouse" = "Hải đăng Inubosaki";
"attraction_inubosaki_lighthouse_desc" = "Hải đăng trắng ở cực đông Kanto, điểm ngắm bình minh đầu năm trên Thái Bình Dương";
"attraction_nokogiriyama" = "Núi Nokogiri";
"attraction_nokogiriyama_desc" = "Ngọn núi nổi tiếng với đài ngắm địa ngục bên vách đá và Đại Phật, lên đỉnh bằng cáp treo";
"attraction_sunpu_castle" = "Thành Sunpu";
"attraction_sunpu_castle_desc" = "Tòa thành nơi Tokugawa Ieyasu sống những năm cuối đời, nay là công viên rộng rãi";
"attraction_omuroyama" = "Núi Omuro";
"attraction_omuroyama_desc" = "Biểu tượng của Izu với dáng bát tô đẹp, cảnh đỉnh núi lên bằng ghế treo đầy ấn tượng";

"gourmet_shirunashi_tantanmen" = "Tantanmen khô";
"gourmet_shirunashi_tantanmen_desc" = "Tantanmen không nước dùng, cay với hạt tiêu Tứ Xuyên và ớt, nguồn gốc Hiroshima";
"gourmet_gansu" = "Gansu";
"gourmet_gansu_desc" = "Món tủ Hiroshima, chả cá xay chiên, kết cấu xốp hợp với đồ uống";
"gourmet_shinshu_salmon" = "Cá hồi Shinshu";
"gourmet_shinshu_salmon_desc" = "Cá thương hiệu do Nagano nuôi, nổi bật với thịt mịn và vị đậm đà";
"gourmet_nagano_gohei_mochi" = "Gohei mochi";
"gourmet_nagano_gohei_mochi_desc" = "Cơm giã quấn que, phết sốt miso ngọt cay rồi nướng";
"gourmet_turkish_rice" = "Cơm Thổ Nhĩ Kỳ";
"gourmet_turkish_rice_desc" = "Món Âu Nagasaki, cơm pilaf, mì Ý và katsu trên một đĩa, rất no";
"gourmet_hatoshi" = "Hatoshi";
"gourmet_hatoshi_desc" = "Món Hoa kiểu Nagasaki, kẹp chả tôm giữa bánh mì rồi chiên giòn";
"gourmet_hanton_rice" = "Cơm Hanton";
"gourmet_hanton_rice_desc" = "Món Âu Kanazawa, phủ cá trắng chiên lên cơm trứng, thường có sốt tartar";
"gourmet_kanazawa_oden" = "Oden Kanazawa";
"gourmet_kanazawa_oden_desc" = "Oden Kanazawa với nguyên liệu độc đáo như bánh mì căn và ốc bai, trong nước dùng đậm đà";
"gourmet_harako_meshi" = "Cơm cá hồi và trứng harako";
"gourmet_harako_meshi_desc" = "Món địa phương Miyagi, cơm nấu nước luộc cá hồi phủ cá hồi và trứng cá, hương vị mùa thu";
"gourmet_aburafu_don" = "Cơm aburafu";
"gourmet_aburafu_don_desc" = "Cơm hộp trứ danh bắc Miyagi, bánh mì căn chiên om trứng, vị dịu nhẹ";
"gourmet_asuka_nabe" = "Lẩu Asuka";
"gourmet_asuka_nabe_desc" = "Lẩu Nara, ninh gà và rau trong nước dashi nền sữa, vị dịu êm";
"gourmet_chagayu" = "Chagayu (cháo trà)";
"gourmet_chagayu_desc" = "Cháo Nara nấu bằng trà hojicha, vị nhẹ, thường ăn sáng";
"gourmet_futomaki_sushi" = "Sushi cuộn to futomaki";
"gourmet_futomaki_sushi_desc" = "Sushi cuộn trang trí rực rỡ của Chiba, hiện hoa hay hoa văn khi cắt";
"gourmet_hakarime_don" = "Cơm lươn hakarime";
"gourmet_hakarime_don_desc" = "Cơm trứ danh Futtsu, lươn biển rưới sốt mặn ngọt; \"hakarime\" là tên địa phương của anago";
"gourmet_shizuoka_oden" = "Oden Shizuoka";
"gourmet_shizuoka_oden_desc" = "Oden Shizuoka, ninh nguyên liệu xiên que trong nước dùng đen, rắc bột dashi và rong aonori";
"gourmet_fujinomiya_yakisoba" = "Yakisoba Fujinomiya";
"gourmet_fujinomiya_yakisoba_desc" = "Yakisoba địa phương Shizuoka, sợi dai và bột cá mòi đặc trưng";

